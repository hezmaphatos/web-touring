# Public API base URL (browser)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
# API base URL used by the Next.js server (can be an internal address)
API_URL=http://localhost:8000/api/v1
# Must match the backend REVALIDATE_SECRET
REVALIDATE_SECRET=
# Fallback site name; the API value wins when available
SITE_NAME=Logbook
# Public URL of this site, used for metadata, sitemap and robots
NEXT_PUBLIC_SITE_URL=http://localhost:3000
