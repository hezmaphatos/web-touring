APP_NAME=Logbook
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL is the default. For a quick local run you can use sqlite instead:
# DB_CONNECTION=sqlite (and remove the other DB_* lines)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=logbook
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Logbook
SITE_NAME=Logbook
ADMIN_EMAIL=
# Public Next.js site, used as the CORS allow-list
FRONTEND_URL=http://localhost:3000
# Next.js revalidate endpoint, called by a queued job after content changes
FRONTEND_REVALIDATE_URL=http://localhost:3000/api/revalidate
# Long random string, must match the frontend REVALIDATE_SECRET
REVALIDATE_SECRET=
